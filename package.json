{
  "name": "documind-ai",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deploy": "node -e \"const required=['DATABASE_URL']; const missing=required.filter((key)=>!process.env[key]); if(missing.length){ console.error('Missing env:', missing.join(', ')); process.exit(1); } console.log('Deploy checks passed: required envs present.');\""
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.5.438",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^5.1.1",
    "unpdf": "^1.9.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
